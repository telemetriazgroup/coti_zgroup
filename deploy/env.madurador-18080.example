# Copiar a .env en el servidor (ajustar DB, JWT y IP si aplica)
# Despliegue: Node escucha en 18080, app bajo /madurador, público vía https://ztrack.app/madurador/

NODE_ENV=production
PORT=18080

# Misma subruta que en Apache ProxyPass y que en el build (npm run build:madurador)
PUBLIC_BASE_PATH=/madurador

# Origen que ve el navegador (HTTPS detrás del proxy)
FRONTEND_URL=https://ztrack.app
# Si también probáis por IP:puerto sin proxy:
ALLOWED_ORIGINS=http://161.132.53.51:18080

COOKIE_SECURE=true
TRUST_PROXY=1
RELAX_HELMET_HTTP=0

# Base de datos (ajustar host/puerto según tu instalación)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=zgroup_cotizaciones
DB_USER=zgroup_user
DB_PASSWORD=cambiar

JWT_ACCESS_SECRET=cambiar_access_secret_minimo_32_caracteres
JWT_REFRESH_SECRET=cambiar_refresh_secret_minimo_32_caracteres
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Redis / PDF / S3: ver .env.example raíz del proyecto
