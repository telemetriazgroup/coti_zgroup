# ─────────────────────────────────────────────────────────────────────────────
# Copiar a la RAÍZ del repo como archivo `.env` (junto a docker-compose.yml)
# Guía: deploy/README.md
# ─────────────────────────────────────────────────────────────────────────────

# Puerto en el HOST donde se publica la app (contenedor sigue usando 3000 dentro)
APP_HOST_PORT=18080

# Build del SPA: DEBE coincidir con PUBLIC_BASE_PATH + barra final
VITE_BASE_PATH=/madurador/

# Runtime Express: mismo prefijo SIN barra final
PUBLIC_BASE_PATH=/madurador

# Origen HTTPS que ve el usuario (Apache → proxy hacia Docker)
FRONTEND_URL=https://ztrack.app
ALLOWED_ORIGINS=http://161.132.53.51:18080

COOKIE_SECURE=true
TRUST_PROXY=1
RELAX_HELMET_HTTP=0

# Claves (generar en producción: openssl rand -hex 32)
JWT_ACCESS_SECRET=cambiar_access_secret_minimo_32_caracteres
JWT_REFRESH_SECRET=cambiar_refresh_secret_minimo_32_caracteres

DB_PASSWORD=cambiar_db_password_seguro

# PostgreSQL en el host (mapeo en docker-compose: por defecto 5433→5432)
POSTGRES_HOST_PORT=5433

# Redis en el host (por defecto 6382)
REDIS_HOST_PORT=6382

# MinIO API / consola en el host — el navegador debe alcanzar S3_PUBLIC_ENDPOINT
MINIO_API_HOST_PORT=9010
MINIO_CONSOLE_HOST_PORT=9011
# URL pública para firmas S3 (planos). Sustituir IP o dominio por el del servidor.
S3_PUBLIC_ENDPOINT=http://161.132.53.51:9010

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=cambiar_minio

# Email admin inicial (seed idempotente)
ADMIN_EMAIL=admin@zgroup.pe
ADMIN_PASSWORD=cambiar

# Odoo 17 Contactos (etapa 0: probe; ODOO_SYNC_ENABLED=0 hasta etapa 3)
# ODOO_URL=https://odoo.ejemplo.pe
# ODOO_DB=
# ODOO_USER=integracion.ztrack
# ODOO_API_KEY=
# ODOO_TIMEOUT_MS=20000
# ODOO_SYNC_ENABLED=0
